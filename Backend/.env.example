# Django Core
DJANGO_SECRET_KEY=replace-with-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Supabase PostgreSQL connection string; falls back to SQLite locally if unset)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://ielets-website44.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,https://ielets-website44.vercel.app

# Supabase Auth JWT Verification
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_URL=https://<project-ref>.supabase.co

# Cloudflare R2 (S3-Compatible Object Storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=bandora-ielts-media
R2_PUBLIC_BASE_URL=https://media.yourdomain.com

# AI Evaluation Providers
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
